FROM nvcr.io/nvidia/l4t-base:r32.7.1

# System dependencies
RUN apt-get update && apt-get install -y \
    python3-pip \
    libgl1-mesa-glx \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY src/edge/requirements.txt ./requirements.txt
RUN pip3 install --no-cache-dir -r requirements.txt

COPY src/edge/ ./src/edge/
COPY config/edge.yaml ./config/edge.yaml

CMD [" python3\, \src/edge/main.py\]
